<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
 "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="jp.kronos.ems.mapper.DeptMapper">
    <resultMap id="Dept" type="jp.kronos.ems.domain.Dept">
        <id property="id" column="ID" />
        <result property="dname" column="DNAME" />
        <result property="description" column="DESCRIPTION" />
    </resultMap>

    <select id="findAll" resultMap="Dept">
        select
            ID,
            DNAME,
            DESCRIPTION
        from
            DEPT
        order by
            ID asc
    </select>
    <select id="findById" resultMap="Dept">
        select
            ID,
            DNAME,
            DESCRIPTION
        from
            DEPT
        where
            ID = #{id}
    </select>
    <insert id="save" useGeneratedKeys="true" keyProperty="id">
        insert into DEPT (
            DNAME,
            DESCRIPTION
        ) values (
            #{dname},
            #{description}
        )
    </insert>
    <delete id="delete">
        delete from
            DEPT
        where
            ID = #{id}
    </delete>
    
    <update id="update">
        update DEPT
        set
            DNAME = #{dname},
            DESCRIPTION = #{description}
        where
            ID = #{id}
    </update>

</mapper>